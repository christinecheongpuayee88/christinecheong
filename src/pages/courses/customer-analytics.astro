  .topic-body {
    padding-bottom: var(--sp-4);
  }

  /* ── Cards ───────────────────────────────────────────── */
  .card-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-4);
    margin-bottom: var(--sp-5);
