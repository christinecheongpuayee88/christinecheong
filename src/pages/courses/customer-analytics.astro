<script>
  const tabs = document.querySelectorAll('.tab-btn');
  const panels = document.querySelectorAll('.tab-panel');

  tabs.forEach(btn => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.tab;
      tabs.forEach(t => t.classList.remove('tab-btn--active'));
      btn.classList.add('tab-btn--active');
      panels.forEach(p => {
        p.classList.toggle('tab-panel--hidden', p.id !== `panel-${target}`);
      });
      const activePanel = document.getElementById(`panel-${target}`);
      const firstSubTab = activePanel.querySelector('.sub-tab');
      if (firstSubTab) firstSubTab.click();
    });
  });

  function activateSubTab(btn) {
    const target = btn.dataset.sub;
    const bar = btn.closest('.sub-tab-bar') || btn.closest('.tab-panel').querySelector('.sub-tab-bar');
    const panel = bar.closest('.tab-panel');
    bar.querySelectorAll('.sub-tab').forEach(t => t.classList.remove('sub-tab--active'));
    btn.classList.add('sub-tab--active');
    panel.querySelectorAll('.sub-panel').forEach(sp => {
      sp.classList.toggle('sub-panel--hidden', sp.id !== target);
    });
    const tabBar = document.getElementById('tab-bar');
    if (tabBar) tabBar.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  document.querySelectorAll('.sub-tab').forEach(btn => {
    btn.addEventListener('click', () => activateSubTab(btn));
  });

  document.querySelectorAll('.tab-panel').forEach(panel => {
    const subTabs = Array.from(panel.querySelectorAll('.sub-tab'));
    const subPanels = Array.from(panel.querySelectorAll('.sub-panel'));

    subPanels.forEach((sp, i) => {
      const nav = document.createElement('div');
      nav.className = 'sub-nav';
      nav.innerHTML = '<div class="wrap"><div class="sub-nav__inner">'
        + (i > 0
          ? `<button class="sub-nav-btn sub-nav-btn--back" data-dir="-1"><span class="sub-nav-arrow">←</span> Back: ${subTabs[i - 1].textContent.trim()}</button>`
          : '')
        + (i < subPanels.length - 1
          ? `<button class="sub-nav-btn sub-nav-btn--next" data-dir="1">Next: ${subTabs[i + 1].textContent.trim()} <span class="sub-nav-arrow">→</span></button>`
          : '')
        + '</div></div>';
      sp.appendChild(nav);

      nav.querySelectorAll('.sub-nav-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const dir = parseInt(btn.dataset.dir);
          const nextTab = subTabs[i + dir];
          if (nextTab) activateSubTab(nextTab);
        });
      });
    });
  });
</script>
